FROM nginx:alpine

# Install envsubst for environment variable substitution
RUN apk add --no-cache gettext

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend static files
COPY index.html /usr/share/nginx/html/
COPY styles.css /usr/share/nginx/html/
COPY app.js /usr/share/nginx/html/
COPY apps.html /usr/share/nginx/html/
COPY apps.js /usr/share/nginx/html/
COPY history.html /usr/share/nginx/html/
COPY history.js /usr/share/nginx/html/
COPY signin.html /usr/share/nginx/html/
COPY signup.html /usr/share/nginx/html/
COPY extensions.js /usr/share/nginx/html/
COPY extensions-ui.js /usr/share/nginx/html/
COPY config.js /usr/share/nginx/html/
COPY favicon_handler.py /usr/share/nginx/html/

# Create a startup script that injects environment variables into config.js
# The frontend JS runs in the browser, so it uses localhost:8080 to reach Nginx
# Nginx then proxies API calls to the backend container
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'echo "=========================================="' >> /docker-entrypoint.sh && \
    echo 'echo "  Umbuzo Frontend Starting"' >> /docker-entrypoint.sh && \
    echo 'echo "  API Backend: ${API_BASE_URL:-http://backend:8000}"' >> /docker-entrypoint.sh && \
    echo 'echo "  Frontend URL: https://dingy-choking-dutiful.ngrok-free.dev"' >> /docker-entrypoint.sh && \
    echo 'echo "=========================================="' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo '# Update config.js to point to Nginx proxy via ngrok URL' >> /docker-entrypoint.sh && \
    echo 'sed -i "s|http://localhost:8000|https://dingy-choking-dutiful.ngrok-free.dev|g" /usr/share/nginx/html/config.js' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo '# Start Nginx' >> /docker-entrypoint.sh && \
    echo 'nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]